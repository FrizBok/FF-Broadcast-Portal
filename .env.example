# Port, auf dem der Server lauscht
PORT=3000
# Interface (0.0.0.0 = alle Netzwerke, 127.0.0.1 = nur lokal, z. B. hinter Reverse-Proxy)
HOST=0.0.0.0
# Speicherort für Datenbank & Schlüssel
DATA_DIR=./data
# Hinter Reverse-Proxy (Nginx Proxy Manager, Caddy …): true
TRUST_PROXY=false
# Secure-Cookies erzwingen (true) / abschalten (false). Leer = automatisch
COOKIE_SECURE=
# Zeitzone
TZ=Europe/Berlin
# Adresse der App für Links in Mails, z. B. https://portal.example.de (auch unter System → E-Mail-Versand einstellbar)
APP_URL=
# Schützt die Ersteinrichtung, solange noch kein Konto existiert (empfohlen, wenn der Server aus dem Internet erreichbar ist)
SETUP_TOKEN=
# Verknüpfung der Modul-Kachel „FF Rundown“ (bestehende Installation), z. B. https://ffrundown.fl-tecmedia.de
RUNDOWN_URL=
# Adresse der Overlay Engine (leer = Kachel zeigt „Bald“)
OVERLAY_URL=
# Optional: Mailserver per Umgebung (sonst unter System → E-Mail-Versand)
# SMTP_HOST= SMTP_PORT=587 SMTP_SECURE=starttls SMTP_USER= SMTP_PASS= SMTP_FROM= SMTP_FROM_NAME=FF-Broadcast
# Optional: Protokoll-Aufbewahrung (Tage, min. 7), Backups
# AUDIT_DAYS=90 BACKUP_DIR= BACKUP_INTERVAL_HOURS=6 BACKUP_KEEP=30 BACKUP_ENABLED=true
